{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@zag-js/solid": [
        "./zag-solid/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/examples/**",
    "src/**/tests/**",
    "src/**/*.test.*",
    "src/**/*.stories.*",
    "src/setup-test.ts",
    "src/setup-test.solid2.ts"
  ]
}